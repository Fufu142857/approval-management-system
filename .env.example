# Copy to .env; replace both passwords. Never commit .env.
POSTGRES_USER=approval
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=approval
DATABASE_URL=postgresql://approval:replace-with-a-long-random-password@127.0.0.1:55432/approval
APP_ORIGIN=http://localhost:3000
# false only for local HTTP. Set true behind production HTTPS.
SESSION_COOKIE_SECURE=false
ADMIN_INITIAL_PASSWORD=replace-with-at-least-12-characters
# Integration tests refuse any database whose name does not end with _test.
TEST_DATABASE_URL=postgresql://approval:replace-with-a-long-random-password@127.0.0.1:55432/approval_test
